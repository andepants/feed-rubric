{
  "name": "feed-rubric",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension: user-defined rubric categories, Jev noul scores each feed post",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fixture": "node scripts/build.mjs --fixture",
    "watch": "node scripts/build.mjs --watch",
    "fixture": "python3 -m http.server 18080 --directory fixtures",
    "test": "node scripts/build.mjs --fixture && vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/build.mjs --fixture && playwright test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@playwright/test": "^1.55.0"
  }
}
